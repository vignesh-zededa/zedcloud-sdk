# Prefer a profiles file (~/.config/zedcloud/config.toml); see docs/getting-started.md.
# These variables are the fallback when no profile is selected.

# Select a profile from the profiles file instead of the variables below.
# ZEDCLOUD_PROFILE=acme-prod

ZEDCLOUD_BASE_URL=https://zedcontrol.zededa.net

# Either a session/API token…
ZEDCLOUD_TOKEN=
# …or username/password (the SDK logs in and re-logs in on expiry).
# ZEDCLOUD_USERNAME=
# ZEDCLOUD_PASSWORD=
# ZEDCLOUD_ENTERPRISE=

# Optional: X-API-KEY for the Kubernetes service (defaults to the session token).
# ZEDCLOUD_API_KEY=

# Optional tuning.
# ZEDCLOUD_TIMEOUT=30
# ZEDCLOUD_MAX_RETRIES=3
# ZEDCLOUD_VERIFY=true           # false, or a CA bundle path

# MCP server, env-only mode: allow writes for the single "env" tenant.
# ZEDCLOUD_MCP_ALLOW_WRITES=false
