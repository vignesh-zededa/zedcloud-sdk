# Tenant control-plane URL (no trailing path required)
ZEDCLOUD_BASE_URL=https://zedcontrol.zededa.net

# Session / API token — sent as Authorization: Bearer <token>
ZEDCLOUD_TOKEN=

# Optional; Kubernetes/ZKS service also accepts X-API-KEY (defaults to ZEDCLOUD_TOKEN)
# ZEDCLOUD_API_KEY=

# Optional tuning
# ZEDCLOUD_TIMEOUT=30
# ZEDCLOUD_MAX_RETRIES=3
